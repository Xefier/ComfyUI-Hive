# Hive runs these on Linux: a CR at the end of a line breaks them
*.sh text eol=lf
*.conf text eol=lf
comfyui-hive/*.py text eol=lf
comfyui-hive/*.txt text eol=lf
comfyui-hive/*.html text eol=lf
comfyui-hive/*.json text eol=lf
comfyui-hive/workflows/*.json text eol=lf
# And these on Windows
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
